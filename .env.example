# Подключение к базе данных (PostgreSQL / Neon)
# Создайте копию: cp .env.example .env

# Пулинговое подключение для приложения
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Прямое подключение (для Prisma CLI / миграций)
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"